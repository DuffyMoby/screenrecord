---
BasedOnStyle: Google
IndentWidth: 4
ColumnLimit: 80
AccessModifierOffset: -4
PointerAlignment: Left
DerivePointerAlignment: false
AllowShortFunctionsOnASingleLine: Empty
SeparateDefinitionBlocks: Always

# Windows headers must come first: many SDK headers assume windows.h is
# already included. Group 0 pins it above everything else.
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^<windows\.h>'
    Priority: 0
  - Regex: '^<(d3d|dxgi|wrl)'
    Priority: 1
  - Regex: '^<'
    Priority: 2
  - Regex: '^"'
    Priority: 3
